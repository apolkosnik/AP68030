+    reg [63:0] b;
+    begin
+      b=mem[addr>>3];
+      memory_long=addr[2] ? {b[47:32],b[63:48]} : {b[15:0],b[31:16]};
+    end
+  endfunction
+  function [31:0] merged(input [31:0] oldv,input [31:0] newv,input integer off,input integer n);
