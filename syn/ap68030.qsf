set_instance_assignment -name VIRTUAL_PIN ON -to fetch_stop_v
set_instance_assignment -name VIRTUAL_PIN ON -to fetch_stop[*]
set_instance_assignment -name VIRTUAL_PIN ON -to fetch_scan_v
set_instance_assignment -name VIRTUAL_PIN ON -to fetch_scan_to[*]
set_instance_assignment -name VIRTUAL_PIN ON -to dbg_halted
