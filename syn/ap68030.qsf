set_instance_assignment -name VIRTUAL_PIN ON -to fast_word[*]
set_instance_assignment -name VIRTUAL_PIN ON -to fast_rdata[*]
set_instance_assignment -name VIRTUAL_PIN ON -to dbg_pc[*]
set_instance_assignment -name VIRTUAL_PIN ON -to dbg_sr[*]
set_instance_assignment -name VIRTUAL_PIN ON -to dbg_state[*]
set_instance_assignment -name VIRTUAL_PIN ON -to dbg_inst
set_instance_assignment -name VIRTUAL_PIN ON -to tm_pop[*]
set_instance_assignment -name VIRTUAL_PIN ON -to tm_md[*]
set_instance_assignment -name VIRTUAL_PIN ON -to tm_q[*]
